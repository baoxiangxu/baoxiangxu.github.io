# Keep shell scripts LF so they stay runnable on macOS/Linux even when the repo
# is cloned on Windows; keep .bat CRLF so it stays runnable on Windows.
* text=auto eol=lf
*.bat text eol=crlf
*.command text eol=lf
*.sh text eol=lf

# Never let git rewrite binaries
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
